<?xml version="1.0" encoding="utf-8"?>
<!-- 开发用的测试面板（2026-10-28 起重新启用：modinfo 里 AddUserInterfaces 生效 +
     入口开关 MODMISC_WB_TEST_ENTRY_ENABLED = true）。
     按钮分三段，见下面「操作按钮」上方的说明：待验证可见 / 已实证可用 Hidden /
     已实证失败已删除。功能本身仍然通过 ExposedMembers 暴露给其它 mod。 -->
<Context>
    <!-- 注意：控件 ID 不能与上下文/文件名（WorldBuilderTestPanel）同名。
         尺寸/字号是设计基准（900x760），运行时按屏幕尺寸等比缩放。
         选择器 = 收起状态按钮 + 点击后在本面板内展开的列表（列表自绘，不依赖引擎下拉弹窗）。 -->
    <Container ID="WorldBuilderTestRoot" Anchor="C,C" Size="900,760" ConsumeMouse="1" Hidden="1">
        <Box Anchor="C,C" Size="parent,parent" Color="20,20,30,248">
            <Grid Anchor="C,C" Size="parent+16,parent+16" Style="ScreenFrame" />

            <Grid ID="WorldBuilderTestHeader" Anchor="L,T" Size="parent,56"
                  Texture="TopBar_Bar" SliceCorner="28,8" SliceTextureSize="57,29">
                <Label ID="WorldBuilderTestTitle" Anchor="L,C" Offset="24,0" Size="740,44"
                       FontSize="32" FontStyle="glow" ColorSet="ShellHeader"
                       String="LOC_MODMISC_WB_TEST_TITLE" />
                <Button ID="WorldBuilderTestCloseButton" Anchor="R,C" Offset="-14,0" Size="44,44"
                       Texture="Controls_CloseButton" Style="ButtonNormalText" ConsumeMouse="1" />
            </Grid>

            <Label ID="WorldBuilderTestStatus" Anchor="L,T" Offset="20,64" Size="parent-40,32"
                   FontSize="22" Color="225,225,225,255" WrapWidth="860" VerticalAlignment="Center" />

            <!-- ============ 选择器 1：目标玩家 ============ -->
            <Label ID="WorldBuilderTestPlayerLabel" Anchor="L,T" Offset="20,110" Size="170,56"
                   FontSize="26" Color="225,225,225,255" VerticalAlignment="Center"
                   String="LOC_MODMISC_WB_TEST_PLAYER" />
            <GridButton ID="WorldBuilderTestPlayerButton" Anchor="L,T" Offset="200,110" Size="660,56"
                        Style="ButtonControl" FontSize="26" String="" />

            <!-- ============ 选择器 2：目标文明 ============ -->
            <Label ID="WorldBuilderTestCivLabel" Anchor="L,T" Offset="20,178" Size="170,56"
                   FontSize="26" Color="225,225,225,255" VerticalAlignment="Center"
                   String="LOC_MODMISC_WB_TEST_CIV" />
            <GridButton ID="WorldBuilderTestCivButton" Anchor="L,T" Offset="200,178" Size="660,56"
                        Style="ButtonControl" FontSize="26" String="" />

            <!-- ============ 选择器 3：目标领袖 ============ -->
            <Label ID="WorldBuilderTestLeaderLabel" Anchor="L,T" Offset="20,246" Size="170,56"
                   FontSize="26" Color="225,225,225,255" VerticalAlignment="Center"
                   String="LOC_MODMISC_WB_TEST_LEADER" />
            <GridButton ID="WorldBuilderTestLeaderButton" Anchor="L,T" Offset="200,246" Size="660,56"
                        Style="ButtonControl" FontSize="26" String="" />

            <!-- ============ 选择器 4：玩家类型（主要文明 / 城邦） ============ -->
            <Label ID="WorldBuilderTestTypeLabel" Anchor="L,T" Offset="20,314" Size="170,56"
                   FontSize="26" Color="225,225,225,255" VerticalAlignment="Center"
                   String="LOC_MODMISC_WB_TEST_PLAYER_TYPE" />
            <GridButton ID="WorldBuilderTestTypeButton" Anchor="L,T" Offset="200,314" Size="660,56"
                        Style="ButtonControl" FontSize="26" String="" />

            <!-- ============ 选择器 5：放置范围（2 / 4 / 6 格） ============ -->
            <Label ID="WorldBuilderTestRangeLabel" Anchor="L,T" Offset="20,382" Size="170,56"
                   FontSize="26" Color="225,225,225,255" VerticalAlignment="Center"
                   String="LOC_MODMISC_WB_TEST_PLACE_RANGE" />
            <GridButton ID="WorldBuilderTestRangeButton" Anchor="L,T" Offset="200,382" Size="660,56"
                        Style="ButtonControl" FontSize="26" String="" />

            <!-- ============ 操作按钮 ============
                 2026-10-28 按授权者要求整理成三段：
                   ① 待验证 —— 还没实机证实的功能，保持可见（本次新增的「添加玩家」在这里）
                   ② 已实证可用 —— 保留代码，Hidden="1"；要复测把那行的 Hidden 去掉即可
                   ③ 已实证失败 —— 直接删除（连同 Lua 回调与文案），依据
                      API_Verification_Status.md：
                        · 补建幽灵槽位（StartCityState）→ #3：Players[slot] 恒为 nil
                        · 设时代（对局内 SetPlayerEra）  → #48：调得到，但改了不生效 -->

            <!-- —— ① 待验证 —— -->
            <GridButton ID="WorldBuilderTestAddPlayer" Anchor="L,T" Offset="20,448" Size="280,60"
                        Style="ButtonControl" FontSize="22" String="LOC_MODMISC_WB_TEST_ADD_PLAYER" />
            <GridButton ID="WorldBuilderTestRemove" Anchor="L,T" Offset="310,448" Size="280,60"
                        Style="ButtonControl" FontSize="24" String="LOC_MODMISC_WB_TEST_REMOVE" />
            <GridButton ID="WorldBuilderTestConvertCityState" Anchor="L,T" Offset="600,448" Size="280,60"
                        Style="ButtonControl" FontSize="24" String="LOC_MODMISC_WB_TEST_CONVERT_CITY_STATE" />

            <!-- 一键把所有主流幽灵城邦化（压测城邦化之后的行为） -->
            <GridButton ID="WorldBuilderTestConvertAllCityState" Anchor="L,T" Offset="20,520" Size="280,60"
                        Style="ButtonControl" FontSize="20" String="LOC_MODMISC_WB_TEST_CONVERT_ALL_CITY_STATE" />
            <!-- 城邦身份自检/修复：把“城邦玩家 + 主流领袖”这类会让官方面板报错的半成品身份修好 -->
            <GridButton ID="WorldBuilderTestRepairCityState" Anchor="L,T" Offset="310,520" Size="280,60"
                        Style="ButtonControl" FontSize="20" String="LOC_MODMISC_WB_TEST_REPAIR_CITY_STATE" />
            <!-- 见面的幽灵转回主流（见面后转城邦 ⇒ 城邦面板打不开 ⇒ 回合卡死） -->
            <GridButton ID="WorldBuilderTestRestoreMetGhosts" Anchor="L,T" Offset="600,520" Size="280,60"
                        Style="ButtonControl" FontSize="20" String="LOC_MODMISC_WB_TEST_RESTORE_MET_GHOSTS" />

            <!-- 幽灵外交压制自检（压测） -->
            <GridButton ID="WorldBuilderTestDiploGhostCheck" Anchor="L,T" Offset="20,592" Size="280,60"
                        Style="ButtonControl" FontSize="22" String="LOC_MODMISC_WB_TEST_DIPLO_GHOST_CHECK" />
            <!-- 幽灵搬移删除单位的方式切换（排障）
                 true = SetDamage(100) + Kill（授权者定的唯一路线）/ false = 仅 Kill（旧行为） -->
            <GridButton ID="WorldBuilderTestGhostKillMode" Anchor="L,T" Offset="310,592" Size="280,60"
                        Style="ButtonControl" FontSize="20" String="LOC_MODMISC_WB_TEST_GHOST_KILL_MODE" />

            <!-- ============ 打开提示信息小窗 ============ -->
            <GridButton ID="WorldBuilderTestMessages" Anchor="L,T" Offset="20,664" Size="860,60"
                        Style="ButtonControl" FontSize="26" String="LOC_MODMISC_WB_TEST_MESSAGES" />

            <!-- —— ② 已实证可用（默认 Hidden="1"，代码与回调都保留）——
                 排在 736 以下是为了不占待验证区的位置；去掉 Hidden 就会出现在这里——
                 注意面板已收到 760 高，复测时要把这些坐标挪回 664 以内。 -->
            <GridButton ID="WorldBuilderTestActivateGhost" Hidden="1" Anchor="L,T" Offset="20,736" Size="200,56"
                        Style="ButtonControl" FontSize="20" String="LOC_MODMISC_WB_TEST_ACTIVATE_GHOST" />
            <GridButton ID="WorldBuilderTestRecycleGhost" Hidden="1" Anchor="L,T" Offset="235,736" Size="200,56"
                        Style="ButtonControl" FontSize="20" String="LOC_MODMISC_WB_TEST_RECYCLE_GHOST" />
            <GridButton ID="WorldBuilderTestApply" Hidden="1" Anchor="L,T" Offset="450,736" Size="200,56"
                        Style="ButtonControl" FontSize="20" String="LOC_MODMISC_WB_TEST_APPLY" />
            <GridButton ID="WorldBuilderTestCreateCity" Hidden="1" Anchor="L,T" Offset="665,736" Size="200,56"
                        Style="ButtonControl" FontSize="20" String="LOC_MODMISC_WB_TEST_CREATE_CITY" />

            <GridButton ID="WorldBuilderTestCreateUnit" Hidden="1" Anchor="L,T" Offset="20,800" Size="200,56"
                        Style="ButtonControl" FontSize="20" String="LOC_MODMISC_WB_TEST_CREATE_UNIT" />
            <GridButton ID="WorldBuilderTestPlaceSettler" Hidden="1" Anchor="L,T" Offset="235,800" Size="200,56"
                        Style="ButtonControl" FontSize="20" String="LOC_MODMISC_WB_TEST_PLACE_SETTLER" />
            <GridButton ID="WorldBuilderTestClearStart" Hidden="1" Anchor="L,T" Offset="450,800" Size="200,56"
                        Style="ButtonControl" FontSize="20" String="LOC_MODMISC_WB_TEST_CLEAR_START" />
            <GridButton ID="WorldBuilderTestGold" Hidden="1" Anchor="L,T" Offset="665,800" Size="200,56"
                        Style="ButtonControl" FontSize="20" String="LOC_MODMISC_WB_TEST_GOLD" />

            <GridButton ID="WorldBuilderTestFaith" Hidden="1" Anchor="L,T" Offset="20,864" Size="200,56"
                        Style="ButtonControl" FontSize="20" String="LOC_MODMISC_WB_TEST_FAITH" />
            <GridButton ID="WorldBuilderTestReveal" Hidden="1" Anchor="L,T" Offset="235,864" Size="200,56"
                        Style="ButtonControl" FontSize="20" String="LOC_MODMISC_WB_TEST_REVEAL" />
            <GridButton ID="WorldBuilderTestPlayerStats" Hidden="1" Anchor="L,T" Offset="450,864" Size="200,56"
                        Style="ButtonControl" FontSize="20" String="LOC_MODMISC_WB_TEST_PLAYER_STATS" />

            <!-- ============ 展开的选项列表（点击选择器后出现在其正下方） ============ -->
            <Container ID="WorldBuilderTestOptionPanel" Anchor="L,T" Size="660,300" ConsumeMouse="1" Hidden="1">
                <Box Anchor="L,T" Size="parent,parent" Color="10,18,28,252">
                    <Grid Anchor="C,C" Size="parent+8,parent+8" Style="ScreenFrame" />
                    <ScrollPanel ID="WorldBuilderTestOptionScroll" Anchor="C,T" Size="parent-8,parent-8"
                                 Vertical="1" AutoScrollBar="0">
                        <Stack ID="WorldBuilderTestOptionList" StackGrowth="Bottom" Anchor="C,T" StackPadding="3" />
                        <ScrollBar Anchor="R,C" Size="11,parent" Offset="2,0" AnchorSide="O,I" Style="ScrollVerticalBar" />
                    </ScrollPanel>
                </Box>
            </Container>
        </Box>

        <!-- ============ 提示信息小窗（操作结果 / 提示） ============ -->
        <Container ID="WorldBuilderTestMessageWindow" Anchor="C,C" Size="680,340" ConsumeMouse="1" Hidden="1">
            <Box Anchor="C,C" Size="parent,parent" Color="14,22,34,250">
                <Grid Anchor="C,C" Size="parent+16,parent+16" Style="ScreenFrame" />

                <Grid ID="WorldBuilderTestMessageHeader" Anchor="L,T" Size="parent,52"
                      Texture="TopBar_Bar" SliceCorner="28,8" SliceTextureSize="57,29">
                    <Label ID="WorldBuilderTestMessageTitle" Anchor="L,C" Offset="20,0" Size="520,40"
                           FontSize="28" FontStyle="glow" ColorSet="ShellHeader"
