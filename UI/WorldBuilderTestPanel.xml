                    <Button ID="WorldBuilderTestMessageClose" Anchor="R,C" Offset="-12,0" Size="40,40"
                            Texture="Controls_CloseButton" Style="ButtonNormalText" ConsumeMouse="1" />
                </Grid>

                <Label ID="WorldBuilderTestMessageText" Anchor="C,T" Offset="0,66" Size="parent-40,parent-86"
                       FontSize="24" Color="225,225,225,255" WrapWidth="640" VerticalAlignment="Top" />
            </Box>
        </Container>
    </Container>

    <!-- 展开列表的条目模板 -->
    <Instance Name="WorldBuilderTestOptionEntry">
        <GridButton ID="EntryButton" Size="620,48" Style="ButtonControl" Anchor="C,T">
            <Label ID="EntryLabel" Anchor="L,C" Offset="12,0" Size="parent-24,parent"
                   FontSize="24" Color="225,225,225,255" VerticalAlignment="Center" TruncateWidth="590" />
        </GridButton>
    </Instance>
</Context>
