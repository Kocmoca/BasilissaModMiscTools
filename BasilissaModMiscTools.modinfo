<?xml version="1.0" encoding="utf-8"?>
<!-- 对外发布号：1.54 → 1.6（开发期内部编号 v1.55…v3.10，见 API_Verification_Status.md §19.34） -->
<Mod id="a1b2c3d4-5e6f-7a8b-9c0d-1e2f3a4b5c6d" version="1.6">
    <Properties>
        <Name>Basilissa Mod Misc Tools</Name>
        <Description>LOC_MODMISC_MOD_DESCRIPTION</Description>
        <Created></Created>
        <Teaser>LOC_MODMISC_MOD_DESCRIPTION</Teaser>
        <Authors>Kocmoca</Authors>
        <AffectsSavedGames>0</AffectsSavedGames>
        <CompatibleVersions>1.2,2.0</CompatibleVersions>
    </Properties>
    <!-- 选项判据：创建游戏界面的开关值 → 决定数据库文件是否加载 -->
    <ActionCriteria>
        <Criteria id="ModMisc_DuplicateCityStates_ON">
            <ConfigurationValueMatches>
                <ConfigurationId>MODMISC_DUPLICATE_CITY_STATES</ConfigurationId>
                <Group>Game</Group>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
    </ActionCriteria>
    <FrontEndActions>
        <!-- 创建游戏界面的选项行（Parameters 表） -->
        <UpdateDatabase id="GhostPlayersOptions">
            <File>GhostPlayers_Options.xml</File>
        </UpdateDatabase>
        <!-- 选项名/说明要在前端就显示，所以前端也挂一份文案 -->
        <UpdateText id="GhostPlayersFrontEndTexts">
            <File>Text.xml</File>
            <File>Text_CN.xml</File>
        </UpdateText>
        <!-- 幽灵玩家池需要城邦槽位：只抬高上限（配置数据库）
             —— 沿用老版方法（前端 UpdateDatabase + SQL，不设 LoadOrder），
             XML 那条（Replace）已撤回：前端与对局内是两套环境，配置数据库这边按老写法来。 -->
        <UpdateDatabase id="GhostPlayersMapSizes">
            <File>GhostPlayers_MapSizes.sql</File>
        </UpdateDatabase>
        <!-- 创建游戏界面：拉满城邦数量并用 WriteCustomData 记下玩家原本的选择 -->
        <ImportFiles id="FrontEndUIReplacements">
            <Properties>
                <LoadOrder>10000</LoadOrder>
            </Properties>
            <File>UI/Replacements/Civ6Common.lua</File>
        </ImportFiles>
        <!-- 跨存档数据存储（UI/ModMiscStore.lua）：把数据编进「配置档的文件名」，
             下一轮从存档列表读回来 —— 原版唯一可用、且已实机验证的跨存档通道。
             前端登记给 include() 用；对局内 UI 那边走 InGameActions 的同名登记。 -->
        <ImportFiles id="FrontEndStore">
            <Properties>
                <LoadOrder>10000</LoadOrder>
            </Properties>
            <File>UI/ModMiscStore.lua</File>
            <!-- 「模组配置组名字」通道（授权者 2026-10-05 提的方向）：
                 模组框架数据库 ModGroups.Name 是自由文本，不受存档名 255 字节限制；
                 前端与对局内都能调 Modding 组接口。依赖 ModMiscStore 的 hex 工具，
                 所以必须排在它后面。 -->
            <File>UI/ModMiscModGroupStore.lua</File>
            <!-- 大载荷门面（优先配置组通道、回退分片 blob）。 -->
            <File>UI/ModMiscBigStore.lua</File>
            <!-- 通用数据协议 + 数据登记表（生命周期/类型/通道；没登记不许写）。 -->
            <File>UI/ModMiscDataProtocol.lua</File>
            <File>UI/ModMiscDataRegistry.lua</File>
            <!-- 引擎设置类键值存储探针（Options.SetUserOption / UserConfiguration.SetValue）：
                 只读探针，不占存档也不占文件名，玩家界面看不见。 -->
            <File>UI/ModMiscNameStoreProbe.lua</File>
        </ImportFiles>
    </FrontEndActions>
    <InGameActions>
        <UpdateDatabase id="Base">
            <Properties>
                <LoadOrder>-1</LoadOrder>
            </Properties>
            <File>ExpansiveUnitBuild.sql</File>
        </UpdateDatabase>
        <!-- 复制城邦：由创建游戏界面的选项控制加载（默认开启）。
             不设 LoadOrder：按默认顺序加载；关掉选项时本文件完全不加载。 -->
        <UpdateDatabase id="GhostPlayersCityStates">
            <Criteria>ModMisc_DuplicateCityStates_ON</Criteria>
            <File>GhostPlayers_CityStates.sql</File>
        </UpdateDatabase>
        <!-- 复制城邦的图标：图标是独立数据库，没法用 SQL 批量拉取，只能逐个定义；
             用 XML（与游戏自己的 Icons_Civilizations.xml 同格式），交给 XML 序列化器，
             避免 SQL 里 "Index" 之类的保留字坑。
             这里【必须设 LoadOrder】：复制体要引用 XP1/XP2/DLC 的图集，
             而官方图标动作加载更早；排在它们之后引用才不会报数据库错
             （报错会中断图标库构建，连官方的图标如 Palenque 一起丢）。 -->
        <UpdateIcons id="GhostPlayersCityStateIcons">
            <Properties>
                <LoadOrder>9000</LoadOrder>
            </Properties>
            <Criteria>ModMisc_DuplicateCityStates_ON</Criteria>
            <File>GhostPlayers_CityStateIcons.xml</File>
        </UpdateIcons>
        <UpdateDatabase id="Support">
            <File>SupportData.sql</File>
        </UpdateDatabase>
        <AddGameplayScripts id="Scripts">
            <Properties>
                <LoadOrder>-1</LoadOrder>
            </Properties>
            <File>ModTool.lua</File>
            <File>ExtensiveUnitBuild.lua</File>
        </AddGameplayScripts>
        <ImportFiles id="Imports">
            <File>ModTool_DataStore.lua</File>
            <File>UI/ModMiscStore.lua</File>
            <File>UI/ModMiscModGroupStore.lua</File>
            <File>UI/ModMiscBigStore.lua</File>
            <File>UI/ModMiscDataProtocol.lua</File>
            <File>UI/ModMiscDataRegistry.lua</File>
            <File>UI/ModMiscNameStoreProbe.lua</File>
            <File>UI/ModMiscAssetStore.lua</File>
            <File>UI/ModMiscCreateGame.lua</File>
            <File>UI/ModMiscTurnEra.lua</File>
            <File>UI/ModMiscSaveGraph.lua</File>
            <File>UI/ModMiscCarrier.lua</File>
            <File>ModTool_TurnEraAPI.lua</File>
            <File>ModTool_TurnEvents.lua</File>
            <File>ModTool_TurnEventHandlers.lua</File>
            <File>ModTool_Support_Functions.lua</File>
            <File>ModTool_Support_UI.lua</File>
            <File>ModTool_WorldBuilderAPI.lua</File>
            <File>ModTool_GhostPlayers.lua</File>
        </ImportFiles>
        <ImportFiles id="UIReplacements">
            <Properties>
                <LoadOrder>10000</LoadOrder>
            </Properties>
            <File>UI/Replacements/Civ6Common.lua</File>
        </ImportFiles>
        <AddUserInterfaces id="SupportUI">
            <Properties>
                <Context>InGame</Context>
                <LoadOrder>-1</LoadOrder>
            </Properties>
            <File>UI/Support_UI.xml</File>
        </AddUserInterfaces>
        <AddUserInterfaces id="MapButtonUI">
            <Properties>
                <Context>InGame</Context>
                <LoadOrder>-1</LoadOrder>
            </Properties>
            <File>UI/MapButton_UI.xml</File>
        </AddUserInterfaces>
        <AddUserInterfaces id="LeftSideBar">
            <Properties>
                <Context>InGame</Context>
                <LoadOrder>-1</LoadOrder>
            </Properties>
            <File>UI/LeftSideBar.xml</File>
        </AddUserInterfaces>
        <!-- Automation 调试面板（「对局内创建新局 / 换地图」测试入口）：**已收起来**
             （2026-10-07 授权者要求 —— 不能留着）。面板代码与侧栏开关
             （UI/AutomationTestPanel.lua 的 MODMISC_AUTOMATION_ENTRY_ENABLED）都保留，
             要再用时把下面这段 AddUserInterfaces 恢复、并把那个开关改 true 即可。
        <AddUserInterfaces id="AutomationTestPanel">
            <Properties>
                <Context>InGame</Context>
                <LoadOrder>-1</LoadOrder>
            </Properties>
            <File>UI/AutomationTestPanel.xml</File>
        </AddUserInterfaces>
        -->
        <!-- WorldBuilder 测试面板：**默认不注册**（发布版收起来；调试幽灵池时很实用）。
             它带玩家列表，能直接看出哪些槽位是幽灵；功能同时也通过 API 暴露给其它 mod
             （ExposedMembers.ModMiscToolScript.* 与 ExposedMembers.ModMiscToolUI.*）。
             需要时把下面这段 AddUserInterfaces 加回来即可：
        <AddUserInterfaces id="WorldBuilderTestPanel">
            <Properties>
                <Context>InGame</Context>
                <LoadOrder>-1</LoadOrder>
            </Properties>
            <File>UI/WorldBuilderTestPanel.xml</File>
        </AddUserInterfaces>
        -->
        <!-- 存档与换图（成品面板）：**面板照旧注册，但侧栏入口默认不注册**
             （2026-10-09 授权者要求 —— 玩家不该再从侧栏进这个面板）。
             开关注释见 UI/ModMiscSavePanel.lua 的 MODMISC_SAVEPANEL_ENTRY_ENABLED；
             别的 mod 用 ExposedMembers.ModMiscToolUI.OpenSavePanel() 打开它。
             存档关系与换图流程见 UI/ModMiscSaveGraph.lua。 -->
        <AddUserInterfaces id="ModMiscSavePanel">
            <Properties>
                <Context>InGame</Context>
                <LoadOrder>-1</LoadOrder>
            </Properties>
            <File>UI/ModMiscSavePanel.xml</File>
        </AddUserInterfaces>
        <AddUserInterfaces id="ModMiscDebugUI">
            <Properties>
                <Context>InGame</Context>
                <LoadOrder>10</LoadOrder>
            </Properties>
            <File>UI/ModMiscDebugUI.xml</File>
            <File>UI/ButtonAdjust.xml</File>
        </AddUserInterfaces>
        <AddUserInterfaces id="ExtensiveUnitPanel">
            <Properties>
                <Context>InGame</Context>
                <LoadOrder>-1</LoadOrder>
            </Properties>
            <File>UI/ExtensiveUnitPanel.xml</File>
        </AddUserInterfaces>
        <UpdateText id="Texts">
            <File>Text.xml</File>
            <File>Text_CN.xml</File>
        </UpdateText>
    </InGameActions>
    <Files>
        <!-- sql -->
        <File>ExpansiveUnitBuild.sql</File>
        <File>GhostPlayers_MapSizes.sql</File>
        <File>SupportData.sql</File>
        <!-- scripts -->
        <File>ModTool.lua</File>
        <File>ModTool_DataStore.lua</File>
        <File>ModTool_Support_Functions.lua</File>
        <File>ModTool_Support_UI.lua</File>
        <File>ModTool_WorldBuilderAPI.lua</File>
        <File>ModTool_GhostPlayers.lua</File>
        <File>GhostPlayers_Options.xml</File>
        <File>GhostPlayers_CityStates.sql</File>
        <File>GhostPlayers_CityStateIcons.xml</File>
        <File>ExtensiveUnitBuild.lua</File>
        <!-- UI -->
        <File>UI/Support_UI.xml</File>
        <File>UI/Support_UI.lua</File>
        <File>UI/MapButton_UI.xml</File>
        <File>UI/MapButton_UI.lua</File>
        <File>UI/ExtensiveUnitPanel.xml</File>
        <File>UI/ExtensiveUnitPanel.lua</File>
        <File>UI/LeftSideBar.xml</File>
        <File>UI/LeftSideBar.lua</File>
        <File>UI/AutomationTestPanel.xml</File>
        <File>UI/AutomationTestPanel.lua</File>
        <File>UI/WorldBuilderTestPanel.xml</File>
        <File>UI/WorldBuilderTestPanel.lua</File>
        <File>UI/ModMiscDebugUI.xml</File>
        <File>UI/ModMiscDebugUI.lua</File>
        <File>UI/ButtonAdjust.xml</File>
        <File>UI/ButtonAdjust.lua</File>
        <File>UI/ButtonAdjust_PHONE.lua</File>
        <File>UI/Replacements/Civ6Common.lua</File>
        <File>UI/ModMiscStore.lua</File>
        <File>UI/ModMiscModGroupStore.lua</File>
        <File>UI/ModMiscBigStore.lua</File>
        <File>UI/ModMiscDataProtocol.lua</File>
        <File>UI/ModMiscDataRegistry.lua</File>
        <File>UI/ModMiscNameStoreProbe.lua</File>
        <File>UI/ModMiscAssetStore.lua</File>
        <File>UI/ModMiscCreateGame.lua</File>
        <File>UI/ModMiscTurnEra.lua</File>
        <File>UI/ModMiscSaveGraph.lua</File>
        <File>UI/ModMiscSavePanel.xml</File>
        <File>UI/ModMiscSavePanel.lua</File>
        <File>UI/ModMiscCarrier.lua</File>
        <File>ModTool_TurnEraAPI.lua</File>
        <File>ModTool_TurnEvents.lua</File>
        <File>ModTool_TurnEventHandlers.lua</File>
        <!-- texts -->
        <File>Text.xml</File>
        <File>Text_CN.xml</File>
        <!-- docs -->
        <File>API_Documentation.txt</File>
        <!-- 【发布态 2026-10-06】三个探针文件（FrontEnd_SaveProbe / FrontEnd_GameSaveProbe /
             LoadTime_SaveProbe）已按授权者要求移除：它们的结论（前端存档闪退、载入期存档闪退）
             保留在 API_Verification_Status.md 第 17/32-37/73 节，代码不再随包分发。
             ModMiscNameStoreProbe 仍保留（Automation 测试面板的通道自检要用）。 -->
        <!-- API_Verification_Status.md 只在仓库里做文档，不进 mod 清单：
             .txt 文档一直在清单里没问题，.md 属未验证扩展名；而 2026-10-01 的连续
             “游戏加载出错”最终以“回退 + 只扩城邦”收场（见 API_Verification_Status.md 第 7 节），
             文档不参与运行，就不放进分发清单了。 -->
        <File>Introduction.txt</File>
        <File>Introduction_EN.txt</File>
    </Files>
    <LocalizedText>
        <Text id="LOC_MODMISC_MOD_DESCRIPTION">
            <en_US>Basilissa Mod - Misc Tools: Extended unit build system with dynamic toolbar and empire overview panel.</en_US>
            <zh_Hans_CN>Basilissa Mod - 杂项工具：扩展单位建造系统、动态工具栏与帝国概况面板。</zh_Hans_CN>
        </Text>
        <File>Text.xml</File>
        <File>Text_CN.xml</File>
    </LocalizedText>
</Mod>
