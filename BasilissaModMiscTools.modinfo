<?xml version="1.0" encoding="utf-8"?>
<Mod id="a1b2c3d4-5e6f-7a8b-9c0d-1e2f3a4b5c6d" version="1.42">
    <Properties>
        <Name>Basilissa Mod Misc Tools</Name>
        <Description>LOC_MODMISC_MOD_DESCRIPTION</Description>
        <Created></Created>
        <Teaser>LOC_MODMISC_MOD_DESCRIPTION</Teaser>
        <Authors>Kocmoca</Authors>
        <AffectsSavedGames>0</AffectsSavedGames>
        <CompatibleVersions>1.2,2.0</CompatibleVersions>
    </Properties>
    <InGameActions>
        <UpdateDatabase id="Base">
            <Properties>
                <LoadOrder>-1</LoadOrder>
            </Properties>
            <File>ExpansiveUnitBuild.sql</File>
        </UpdateDatabase>
        <UpdateDatabase id="Support">
            <File>SupportData.sql</File>
        </UpdateDatabase>
        <AddGameplayScripts id="Scripts">
            <Properties>
                <LoadOrder>-1</LoadOrder>
            </Properties>
            <File>ModTool.lua</File>
            <File>ExtensiveUnitBuild.lua</File>
        </AddGameplayScripts>
        <ImportFiles id="Imports">
            <File>ModTool_Support_Functions.lua</File>
            <File>ModTool_Support_UI.lua</File>
        </ImportFiles>
        <AddUserInterfaces id="SupportUI">
            <Properties>
                <Context>InGame</Context>
                <LoadOrder>-1</LoadOrder>
            </Properties>
            <File>UI/Support_UI.xml</File>
        </AddUserInterfaces>
        <AddUserInterfaces id="MapButtonUI">
            <Properties>
                <Context>InGame</Context>
                <LoadOrder>-1</LoadOrder>
            </Properties>
            <File>UI/MapButton_UI.xml</File>
        </AddUserInterfaces>
        <AddUserInterfaces id="LeftSideBar">
            <Properties>
                <Context>InGame</Context>
                <LoadOrder>-1</LoadOrder>
            </Properties>
            <File>UI/LeftSideBar.xml</File>
        </AddUserInterfaces>
        <AddUserInterfaces id="ModMiscDebugUI">
            <Properties>
                <Context>InGame</Context>
                <LoadOrder>10</LoadOrder>
            </Properties>
            <File>UI/ModMiscDebugUI.xml</File>
            <File>UI/ButtonAdjust.xml</File>
        </AddUserInterfaces>
        <AddUserInterfaces id="ExtensiveUnitPanel">
            <Properties>
                <Context>InGame</Context>
                <LoadOrder>-1</LoadOrder>
            </Properties>
            <File>UI/ExtensiveUnitPanel.xml</File>
        </AddUserInterfaces>
        <UpdateText id="Texts">
            <File>Text.xml</File>
            <File>Text_CN.xml</File>
        </UpdateText>
    </InGameActions>
    <Files>
        <!-- sql -->
        <File>ExpansiveUnitBuild.sql</File>
        <File>SupportData.sql</File>
        <!-- scripts -->
        <File>ModTool.lua</File>
        <File>ModTool_Support_Functions.lua</File>
        <File>ModTool_Support_UI.lua</File>
        <File>ExtensiveUnitBuild.lua</File>
        <!-- UI -->
        <File>UI/Support_UI.xml</File>
        <File>UI/Support_UI.lua</File>
        <File>UI/MapButton_UI.xml</File>
        <File>UI/MapButton_UI.lua</File>
        <File>UI/ExtensiveUnitPanel.xml</File>
        <File>UI/ExtensiveUnitPanel.lua</File>
        <File>UI/LeftSideBar.xml</File>
        <File>UI/LeftSideBar.lua</File>
        <File>UI/ModMiscDebugUI.xml</File>
        <File>UI/ModMiscDebugUI.lua</File>
        <File>UI/ButtonAdjust.xml</File>
        <File>UI/ButtonAdjust.lua</File>
        <File>UI/ButtonAdjust_PHONE.lua</File>
        <!-- texts -->
        <File>Text.xml</File>
        <File>Text_CN.xml</File>
        <!-- docs -->
        <File>API_Documentation.txt</File>
        <File>Introduction.txt</File>
        <File>Introduction_EN.txt</File>
    </Files>
    <LocalizedText>
        <Text id="LOC_MODMISC_MOD_DESCRIPTION">
            <en_US>Basilissa Mod - Misc Tools: Extended unit build system with dynamic toolbar and empire overview panel.</en_US>
            <zh_Hans_CN>Basilissa Mod - 杂项工具：扩展单位建造系统、动态工具栏与帝国概况面板。</zh_Hans_CN>
        </Text>
        <File>Text.xml</File>
        <File>Text_CN.xml</File>
    </LocalizedText>
</Mod>
